# Public canonical origin
NEXT_PUBLIC_SITE_URL=https://savepinner.com

# Required in production. Generate a long random value and keep it secret.
TOKEN_SECRET=

# AdSense stays completely disabled while these are blank.
# Before enabling, the site must be approved and a Google-certified CMP
# (for example Google Privacy & Messaging) must be configured for the EEA,
# United Kingdom and Switzerland.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
ADSENSE_PUBLISHER_ID=
# Keep false until policy blockers are cleared and a certified CMP is live.
ENABLE_ADSENSE=false

# Optional operational limits
RATE_RESOLVE_PER_MIN=10
RATE_DOWNLOAD_PER_MIN=30
DAILY_BANDWIDTH_CAP_BYTES=2147483648
